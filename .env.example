# =============================================================================
# EDMS Environment Configuration
# Copy this file to .env and customize for your environment
# =============================================================================

# --- Database ---
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://edms:edms@postgres:5432/edms

# --- Security ---
# Secret key for JWT token signing (change in production!)
SECRET_KEY=change-me-to-a-random-secret
# Password for PDF encryption
PDF_ENCRYPTION_PASSWORD=change-me

# --- Redis / Celery ---
# Redis connection URL for caching and Celery broker
REDIS_URL=redis://redis:6379/0
# Celery message broker URL
CELERY_BROKER_URL=redis://redis:6379/0
# Celery result backend URL
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Application ---
# Number of uvicorn worker processes
WORKERS=4
# Log output format: "text" or "json"
LOG_FORMAT=text
# Allow new user registration (true/false)
ALLOW_REGISTRATION=false

# --- ChromaDB (Vector Search) ---
# ChromaDB host and port for vector similarity search
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# Authentication token for ChromaDB
CHROMA_AUTH_TOKEN=changeme

# --- MinIO (Object Storage) ---
# Primary MinIO endpoint for document/backup storage
MINIO_PRIMARY_ENDPOINT=minio:9000
MINIO_PRIMARY_ACCESS_KEY=minioadmin
MINIO_PRIMARY_SECRET_KEY=minioadmin
MINIO_PRIMARY_BUCKET=edms-backup
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- OpenAI (optional, for LLM features) ---
OPENAI_API_KEY=

# --- SMTP (optional, for email notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=edms@example.com

# --- Bootstrap Admin ---
# Initial admin account created on first startup
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_EMAIL=admin@edms.local

# --- Nginx / TLS ---
# TLS certificates are generated via scripts/generate-certs.sh
# For production, replace nginx/certs/server.crt and server.key with real certs
