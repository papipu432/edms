# Database
DATABASE_URL=postgresql+asyncpg://edms:edms@postgres:5432/edms

# Security
SECRET_KEY=change-me-to-a-random-secret
PDF_ENCRYPTION_PASSWORD=change-me

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Application
WORKERS=4
LOG_FORMAT=text
ALLOW_REGISTRATION=false

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=changeme

# MinIO (Primary)
MINIO_PRIMARY_ENDPOINT=minio:9000
MINIO_PRIMARY_ACCESS_KEY=minioadmin
MINIO_PRIMARY_SECRET_KEY=minioadmin
MINIO_PRIMARY_BUCKET=edms-backup
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# OpenAI (optional)
OPENAI_API_KEY=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=edms@example.com

# Bootstrap admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_EMAIL=admin@edms.local
